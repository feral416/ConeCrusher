            <Member Name="velocity" Datatype="LReal">
              <Comment>
                <MultiLanguageText Lang="en-US">Velocity for jogging (Value &gt; 0.0: The specified value is used; Value = 0.0: Permitted; Value &lt; 0.0: The absolute value of the specified value is used)</MultiLanguageText>
