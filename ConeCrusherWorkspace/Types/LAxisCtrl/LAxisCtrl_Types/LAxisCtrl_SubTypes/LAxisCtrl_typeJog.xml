              </Comment>
              <StartValue>-1.0</StartValue>
            </Member>
            <Member Name="positionControlled" Datatype="Bool">
              <Comment>
                <MultiLanguageText Lang="en-US">TRUE: Position-controlled mode; FALSE: Non position-controlled operation</MultiLanguageText>
