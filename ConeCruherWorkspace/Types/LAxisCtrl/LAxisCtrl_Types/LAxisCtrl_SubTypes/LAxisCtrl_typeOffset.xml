  <Engineering version="V21" />
  <SW.Types.PlcStruct ID="0">
    <AttributeList>
      <Interface>
        <Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
          <Section Name="None">
            <Member Name="offset" Datatype="LReal">
              <Comment>
                <MultiLanguageText Lang="en-US">Absolute or relative offset shift</MultiLanguageText>
              </Comment>
              <StartValue>0.0</StartValue>
            </Member>
            <Member Name="profileReference" Datatype="DInt">
              <Comment>
                <MultiLanguageText Lang="en-US">Type of traversing of the following value offset (1: Traverse following value offset using leading value distance starting from the current effective leading value position; 2: Traverse following value offset using leading value distance from the effective leading value position "StartPosition"; 5: Cancel only one waiting job for the following value offset)</MultiLanguageText>
              </Comment>
              <StartValue>1</StartValue>
            </Member>
            <Member Name="offsetDistance" Datatype="LReal">
              <Comment>
                <MultiLanguageText Lang="en-US">Effective leading value distance while traversing the following value offset when "ProfileReference" = 1, 2</MultiLanguageText>
              </Comment>
            </Member>
            <Member Name="startPosition" Datatype="LReal">
              <Comment>
                <MultiLanguageText Lang="en-US">Effective leading value position starting from which the following value offset is traversed when "ProfileReference" = 2</MultiLanguageText>
              </Comment>
            </Member>
            <Member Name="direction" Datatype="DInt">
              <Comment>
                <MultiLanguageText Lang="en-US">Direction of the leading value distance (1: Positive direction; 2: Negative direction; 3: Current direction) when "ProfileReference" = 1, 2</MultiLanguageText>
              </Comment>
              <StartValue>3</StartValue>
            </Member>
            <Member Name="offsetAbsolute" Datatype="Bool">
              <Comment>
                <MultiLanguageText Lang="en-US">Indicates the type of the offset shift. TRUE: Shift the following value as an absolute shift; FALSE: Shift the following value relative to the existing following value shift</MultiLanguageText>
              </Comment>
              <StartValue>TRUE</StartValue>
            </Member>
            <Member Name="offsetChangeOnTheFly" Datatype="Bool">
              <Comment>
                <MultiLanguageText Lang="en-US">TRUE: Changing offset shift on-the-fly at absolute offset shift. FALSE: Offset shift change requires a new rising edge at offset input</MultiLanguageText>
              </Comment>
              <StartValue>FALSE</StartValue>
            </Member>
          </Section>
        </Sections>
      </Interface>
      <Name>LAxisCtrl_typeOffset</Name>
