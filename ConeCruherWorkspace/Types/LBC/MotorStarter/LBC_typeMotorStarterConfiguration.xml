            <Member Name="startingControlTime" Datatype="Time">
              <AttributeList>
                <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
              </AttributeList>
              <Comment>
                <MultiLanguageText Lang="en-US">Control time for receiving feedback motor is running or time to ramp up motor if feedback is disabled</MultiLanguageText>
              </Comment>
              <StartValue>T#5s</StartValue>
            </Member>
            <Member Name="stoppingControlTime" Datatype="Time">
              <AttributeList>
                <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
              </AttributeList>
