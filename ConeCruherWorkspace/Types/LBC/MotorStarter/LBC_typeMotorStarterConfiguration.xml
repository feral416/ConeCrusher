              <StartValue>T#5s</StartValue>
            </Member>
            <Member Name="resetTime" Datatype="Time">
              <AttributeList>
                <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
              </AttributeList>
