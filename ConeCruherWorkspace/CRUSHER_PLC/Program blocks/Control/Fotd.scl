FUNCTION_BLOCK "Fotd"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//FOTD block based on multiple lag. Gains are calculated continuously
VAR_INPUT
  u : LReal;        // Input signal
  K : LReal := 1.0; // Process gain
  Tau : LReal := 1.0; // First-order time constant
  L : LReal := 0.0; // Dead time to approximate
  dt : Time := T#100ms; // Time between executions
  bumplessReset : Bool; // Reset array to K * u
  resetBlock : Bool;         // Reset states
END_VAR

VAR_OUTPUT
  y : LReal; // Approximated FOTD output
END_VAR

VAR_IN_OUT

END_VAR

VAR
  x : Array[0..#ARR_UPP_BOUND] OF LReal;
  initDone : Bool := FALSE;
  prevReset : Bool;
END_VAR

VAR_TEMP
  reset : Bool;
  i : Int;
  alpha : LReal;
  Tlag : LReal;
  Ts : LReal; // Sample time in seconds
  fillVal : LReal;
  idealN : Int;
END_VAR

VAR CONSTANT
  ARR_UPP_BOUND : Int := 10;
  MS_IN_S : LReal := 1000.0;
END_VAR


BEGIN
	#reset := (#resetBlock AND NOT #prevReset) OR NOT #initDone;
	#prevReset := #resetBlock;
	
	// Converting dt to LReal
	#Ts := DINT_TO_LREAL(TIME_TO_DINT(#dt)) / #MS_IN_S;
	
	// Initialize states
	IF #reset THEN
	  IF #bumplessReset THEN
	    #fillVal := #K * #u;
	  ELSE
	    #fillVal := 0.0;
	  END_IF;
	  
	  FOR #i := 0 TO #ARR_UPP_BOUND DO
	    #x[#i] := #fillVal;
	  END_FOR;
	  
	  #initDone := TRUE;
	END_IF;
	
	
	// Safety: if no sample time is given, pass through scaled input
	IF #Ts <= 0.0 THEN
	  #y := #K * #u;
	ELSE
	  
	  // ----------------------------------------------------
	  // 1. First-order process part: K / (1 + Tau*s)
	  // ----------------------------------------------------
	  IF #Tau > 0.0 THEN
	    #alpha := #Ts / (#Tau + #Ts);
	    #x[0] := #x[0] + #alpha * (#K * #u - #x[0]);
	  ELSE
	    #x[0] := #K * #u;
	  END_IF;
	  
	  // ----------------------------------------------------
	  // 2. Dead-time approximation:
	  //    e^{-Ls} approx (1 / (1 + (L/N)s))^N
	  // ----------------------------------------------------
	  IF (#L > 0.0) AND (#Ts > 0.0) THEN
	    
	    // DYNAMIC N CALCULATION
	    // L >= (N - 1) * Ts  =>  N <= (L / Ts) + 1
	    #idealN := LREAL_TO_INT(#L / #Ts) + 1;
	    
	    IF #idealN > #ARR_UPP_BOUND THEN       // Limit to user-defined max (e.g., 10)
	      #idealN := #ARR_UPP_BOUND;
	    ELSIF #idealN < 1 THEN     // Minimum 1 stage
	      #idealN := 1;
	    END_IF;
	    
	    // EXACT COMPENSATION FORMULA
	    // Solves: N * Tlag + (N - 1) * Ts = L  for Tlag
	    #Tlag := (#L - (INT_TO_LREAL(#idealN) - 1.0) * #Ts) / INT_TO_LREAL(#idealN);
	    
	    IF #Tlag < 0.0 THEN
	      #Tlag := 0.0; // Safety clamp (though mathematically guaranteed >= 0 now)
	    END_IF;
	    
	    #alpha := #Ts / (#Tlag + #Ts);
	    
	    // BACKWARD LOOP
	    FOR #i := #idealN TO 1 BY -1 DO
	      #x[#i] := #x[#i] + #alpha * (#x[#i - 1] - #x[#i]);
	    END_FOR;
	    
	    #y := #x[#idealN];
	  ELSE
	    #y := #x[0];
	  END_IF;
	  
	END_IF;
END_FUNCTION_BLOCK

